# Copy to backend/.env. Vars with a default can be omitted.
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://leda:leda@localhost:5432/leda
# Include the deployed frontend origin in production. Keep localhost for local development.
CORS_ORIGINS=http://localhost:5173,https://leda-seven.vercel.app

# Email (invites, waitlist). Leave RESEND_API_KEY empty to log emails instead of sending.
EMAIL_FROM=Leda <hello@leda.africa>
RESEND_API_KEY=

# Storage for voice notes / photos / import files. Leave S3_BUCKET empty to use backend/media on disk.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Paystack (dedicated virtual accounts + webhooks). Empty = fake provider.
PAYSTACK_SECRET_KEY=

# Meta WhatsApp Cloud API. Empty = fake provider.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=leda-verify
WHATSAPP_APP_SECRET=

# Sabi engine. OPENAI_API_KEY powers Whisper transcription and can also power decoding.
# DECODER=auto uses Anthropic if its key is set, else OpenAI, else a deterministic fake. Or set anthropic|openai|fake.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DECODER=auto
OPENAI_DECODER_MODEL=gpt-5.5
CLAUDE_MODEL=claude-opus-5
