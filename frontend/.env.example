# Backend API URL. Leave empty to use the local Vite proxy.
VITE_API_URL=https://leda-399h.vercel.app

# Copy to `.env` and fill in from https://dashboard.emailjs.com
# Setup guide: docs/EMAIL_SETUP.md

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_WELCOME_TEMPLATE_ID=

# Optional: second template that emails the Leda team about each new signup
VITE_EMAILJS_NOTIFY_TEMPLATE_ID=
